{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git init:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git config user.name:*)",
      "Bash(git config user.email:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd)",
      "Bash(curl:*)",
      "Bash(explorer.exe:*)",
      "Bash(open:*)",
      "Bash(pandoc --version)",
      "Bash(weasyprint:*)",
      "Bash(python3 -m json.tool)",
      "WebSearch",
      "Read(//tmp/**)"
    ]
  },
  "outputStyle": "explanatory"
}
