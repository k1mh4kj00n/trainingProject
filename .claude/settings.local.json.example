{
  "_comment": "이 파일은 예시입니다. '.example' 확장자를 제거해 settings.local.json 으로 저장한 뒤 프로젝트에서 자주 쓰는 도메인/명령을 추가하세요. settings.local.json 은 gitignore 처리해 각자 로컬에만 보관하는 것을 권장합니다.",
  "permissions": {
    "allow": [
      "WebFetch(domain:example.com)",
      "WebFetch(domain:namu.wiki)",
      "WebFetch(domain:brunch.co.kr)",
      "WebFetch(domain:velog.io)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(pnpm:*)"
    ]
  }
}
